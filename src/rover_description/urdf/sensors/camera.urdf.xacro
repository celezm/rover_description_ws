<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="sensor_camera" params="node_name node_namespace frame_prefix parent *origin horizontal_fov:=1.089 video_width:=640 video_height:=480">
    
    <joint name="${frame_prefix}camera_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${frame_prefix}camera_frame"/>
    </joint>

    <link name="${frame_prefix}camera_frame">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>
    </link>

    <joint name="${frame_prefix}camera_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
      <parent link="${frame_prefix}camera_frame"/>
      <child link="${frame_prefix}camera_optical_frame"/>
    </joint>

    <link name="${frame_prefix}camera_optical_frame"/>

    <gazebo reference="${frame_prefix}camera_frame">
      <sensor name="${frame_prefix}sensor" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <gz_frame_id>${frame_prefix}camera_optical_frame</gz_frame_id>
        <topic>${node_namespace}/${node_name}/image</topic>

        <camera>
          <horizontal_fov>${horizontal_fov}</horizontal_fov>
          <image>
            <width>${video_width}</width>
            <height>${video_height}</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.10</near>
            <far>15.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

  </xacro:macro>
</robot>
