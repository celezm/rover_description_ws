<?xml version="1.0"?>
<robot name="rover_wheels" xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Dimensiones de rueda basadas en la inercia original del modelo:
       mass=3.0, ixx=iyy=0.19403, izz=0.35189
       Para un cilindro: izz = 0.5*m*r^2 → r = sqrt(2*izz/m) ≈ 0.485
       Usamos r=0.30 (escala visual) y length=0.20 por compatibilidad con el ejemplo -->
  <xacro:property name="wheel_radius"  value="0.30"/>
  <xacro:property name="wheel_length"  value="0.20"/>
  <xacro:property name="wheel_mass"    value="3.0"/>
  <!-- Inercia de cilindro: ixx=iyy = m*(3r²+h²)/12, izz = m*r²/2 -->
  <xacro:property name="wheel_ixx"    value="0.19403"/>
  <xacro:property name="wheel_iyy"    value="0.19403"/>
  <xacro:property name="wheel_izz"    value="0.13500"/>

  <xacro:macro name="rover_wheels" params="parent">

    <!-- ==================== EJES ESTRUCTURALES ==================== -->

    <joint name="axis_left_link_joint" type="fixed">
      <origin rpy="1.60974 -0.01480 -0.06763" xyz="-0.35085 -0.70000 -0.47400"/>
      <parent link="body_link"/>
      <child link="axis_left_link"/>
    </joint>

    <joint name="axis_right_link_joint" type="fixed">
      <origin rpy="-1.57080 0.00000 -0.02477" xyz="-0.35085 0.70000 -0.47400"/>
      <parent link="body_link"/>
      <child link="axis_right_link"/>
    </joint>

    <link name="axis_left_link">
      <collision name="axis_left_collision">
        <origin rpy="-1.55093 0.07494 0.77002" xyz="-0.01304 0.01116 -0.07670"/>
        <geometry>
          <box size="0.95 0.05 0.10"/>
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="0.00100" ixy="-0.00000" ixz="-0.00000" iyy="0.00100" iyz="0.00000" izz="0.00100"/>
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 -0.00000 0.00000"/>
        <mass value="3.00000"/>
      </inertial>
      <visual name="axis_left">
        <material name="orange"/>
        <origin rpy="-1.55093 0.07494 0.77002" xyz="-0.00365 -0.00204 -0.05382"/>
        <geometry>
          <box size="0.95 0.05 0.10"/>
        </geometry>
      </visual>
    </link>

    <link name="axis_right_link">
      <collision name="axis_right_collision">
        <origin rpy="1.58831 -0.01751 -0.78555" xyz="-0.02891 0.01341 -0.04021"/>
        <geometry>
          <box size="0.95 0.05 0.10"/>
        </geometry>
      </collision>
      <inertial>
        <inertia ixx="0.38352" ixy="-0.00000" ixz="0.08781" iyy="1.49498" iyz="0.00000" izz="1.11529"/>
        <origin rpy="0.00000 0.00000 0.00000" xyz="0.00095 0.00000 -0.03832"/>
        <mass value="3.00000"/>
      </inertial>
      <visual name="axis_right">
        <material name="orange"/>
        <origin rpy="1.58831 -0.01751 -0.78555" xyz="0.00095 0.00000 -0.03832"/>
        <geometry>
          <box size="0.95 0.05 0.10"/>
        </geometry>
      </visual>
    </link>

    <!-- ==================== RUEDAS IZQUIERDAS ==================== -->

    <joint name="back_left_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="-0.03655 0.06700 -0.01743" xyz="-1.43329 -0.48979 0.41533"/>
      <parent link="axis_left_link"/>
      <child link="back_left_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="front_left_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="-0.03655 0.06700 -0.01743" xyz="1.55952 -0.54195 0.21447"/>
      <parent link="axis_left_link"/>
      <child link="front_left_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="mid_left_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="-0.03655 0.06700 -0.01743" xyz="0.06311 -0.51587 0.31490"/>
      <parent link="axis_left_link"/>
      <child link="mid_left_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- ==================== RUEDAS DERECHAS ==================== -->

    <joint name="back_right_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="3.14159 -0.02477 -0.00000" xyz="-1.45614 0.52600 0.26402"/>
      <parent link="axis_right_link"/>
      <child link="back_right_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="front_right_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="3.14159 -0.02477 -0.00000" xyz="1.54294 0.52600 0.33832"/>
      <parent link="axis_right_link"/>
      <child link="front_right_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="mid_right_wheel_link_joint" type="continuous">
      <limit effort="50.0" velocity="20.0"/>
      <dynamics damping="0.05" friction="0.1"/>
      <origin rpy="3.14159 -0.02477 -0.00000" xyz="0.04340 0.52600 0.30117"/>
      <parent link="axis_right_link"/>
      <child link="mid_right_wheel_link"/>
      <axis xyz="0 0 1"/>
    </joint>

    <!-- ==================== LINKS DE RUEDAS (cilindros primitivos) ==================== -->

    <link name="back_left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <link name="front_left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <link name="mid_left_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <link name="back_right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <link name="front_right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <link name="mid_right_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_ixx}" ixy="0" ixz="0" iyy="${wheel_iyy}" iyz="0" izz="${wheel_izz}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><cylinder length="${wheel_length}" radius="${wheel_radius}"/></geometry>
      </collision>
    </link>

    <!-- ==================== GAZEBO FRICTION ==================== -->

    <gazebo reference="back_left_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>
    <gazebo reference="mid_left_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>
    <gazebo reference="front_left_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>
    <gazebo reference="back_right_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>
    <gazebo reference="mid_right_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>
    <gazebo reference="front_right_wheel_link">
      <mu1>5</mu1>
      <mu2>5</mu2>
    </gazebo>

  </xacro:macro>

</robot>
